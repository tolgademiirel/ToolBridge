<Application x:Class="MusicShell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="MenuFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EFF4FE" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F6F7F9" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#E4E8EE" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#717A89" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#161A22" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#3F4753" />
        <SolidColorBrush x:Key="ChipBrush" Color="#EEF1F5" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EEF1F5" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#FAFBFC" />
        <SolidColorBrush x:Key="PanelMutedBrush" Color="#F3F5F8" />

        <!-- Semantik durum token'ları -->
        <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EAF7EF" />
        <SolidColorBrush x:Key="SuccessBorderBrush" Color="#A7DDBC" />
        <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FDF3E3" />
        <SolidColorBrush x:Key="WarningBorderBrush" Color="#F0CD96" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC" />
        <SolidColorBrush x:Key="DangerBorderBrush" Color="#F2B8B8" />
        <SolidColorBrush x:Key="InfoBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="InfoSoftBrush" Color="#EFF4FE" />
        <SolidColorBrush x:Key="InfoBorderBrush" Color="#B6CDF8" />
        <SolidColorBrush x:Key="NeutralStatusBrush" Color="#717A89" />
        <SolidColorBrush x:Key="FocusRingBrush" Color="#802563EB" />
        <SolidColorBrush x:Key="ScrimBrush" Color="#66111827" />

        <DropShadowEffect x:Key="SoftShadow" BlurRadius="20" ShadowDepth="3" Opacity="0.05" Color="#000000" />
        <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="6" Opacity="0.12" Color="#111111" />

        <!-- MainWindow'da tekrar eden ikon path'leri için merkezi geometri kaynakları -->
        <Geometry x:Key="IconTrashGeometry">M6,2 L10,2 L11,3 L14,3 L14,5 L2,5 L2,3 L5,3 Z M4,6 L12,6 L11.25,14 L4.75,14 Z M6,7.5 L7,7.5 L7,12.5 L6,12.5 Z M9,7.5 L10,7.5 L10,12.5 L9,12.5 Z</Geometry>
        <Geometry x:Key="IconPrinterGeometry">M4,2 L12,2 L12,5 L4,5 Z M3,6 L13,6 C13.55,6 14,6.45 14,7 L14,11 L12,11 L12,14 L4,14 L4,11 L2,11 L2,7 C2,6.45 2.45,6 3,6 Z M5,10 L5,13 L11,13 L11,10 Z M11.5,7.25 C10.95,7.25 10.5,7.7 10.5,8.25 C10.5,8.8 10.95,9.25 11.5,9.25 C12.05,9.25 12.5,8.8 12.5,8.25 C12.5,7.7 12.05,7.25 11.5,7.25 Z</Geometry>
        <Geometry x:Key="IconOpenGeometry">M8,3 C4.5,3 2,8 2,8 C2,8 4.5,13 8,13 C11.5,13 14,8 14,8 C14,8 11.5,3 8,3 Z M8,5 C9.65,5 11,6.35 11,8 C11,9.65 9.65,11 8,11 C6.35,11 5,9.65 5,8 C5,6.35 6.35,5 8,5 Z M8,6.4 C7.12,6.4 6.4,7.12 6.4,8 C6.4,8.88 7.12,9.6 8,9.6 C8.88,9.6 9.6,8.88 9.6,8 C9.6,7.12 8.88,6.4 8,6.4 Z</Geometry>
        <Geometry x:Key="IconSendGeometry">M8,2 L14,7 L13,8.2 L12,7.35 L12,14 L9.5,14 L9.5,10 L6.5,10 L6.5,14 L4,14 L4,7.35 L3,8.2 L2,7 Z</Geometry>


        <!--
            Tema güvenliği: WPF bazı ContentPresenter/TextBlock alanlarında Foreground değerini otomatik miras almadığı için
            gece modunda siyah yazı kalabiliyordu. Bu temel stiller tüm metinleri aktif tema paletine bağlar.
        -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        </Style>

        <Style TargetType="{x:Type ContentPresenter}">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>

        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>


        <!--
            Modern ince scrollbar: ok butonları yok, transparan track üzerinde
            yuvarlatılmış thumb. Tüm ScrollViewer'lara implicit olarak uygulanır.
        -->
        <Style x:Key="ToolBridgeScrollBarThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbRoot"
                                Background="#66717A89"
                                CornerRadius="4"
                                Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Background" Value="#B3717A89" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Background" Value="#B3717A89" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="ToolBridgeVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                      Height="0"
                                      Focusable="False"
                                      IsTabStop="False"
                                      Visibility="Collapsed" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ToolBridgeScrollBarThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                      Height="0"
                                      Focusable="False"
                                      IsTabStop="False"
                                      Visibility="Collapsed" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="ToolBridgeHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent" SnapsToDevicePixels="True">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                      Width="0"
                                      Focusable="False"
                                      IsTabStop="False"
                                      Visibility="Collapsed" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ToolBridgeScrollBarThumbStyle}" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                      Width="0"
                                      Focusable="False"
                                      IsTabStop="False"
                                      Visibility="Collapsed" />
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template" Value="{StaticResource ToolBridgeVerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Template" Value="{StaticResource ToolBridgeHorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>


        <!--
            ToolBridge Button System
            21st.dev / shadcn button modelinin WPF karşılığıdır.
            Yeni buton gereken alanlarda aşağıdaki stiller kullanılmalıdır:
            ShadcnButtonStyle, ShadcnSecondaryButtonStyle, ShadcnOutlineButtonStyle,
            ShadcnGhostButtonStyle, ShadcnDestructiveButtonStyle, ShadcnIconButtonStyle.
        -->
        <SolidColorBrush x:Key="ButtonPrimaryBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="ButtonPrimaryForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonPrimaryHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="ButtonSecondaryBrush" Color="#EEF1F5" />
        <SolidColorBrush x:Key="ButtonSecondaryHoverBrush" Color="#E2E7EE" />
        <SolidColorBrush x:Key="ButtonOutlineHoverBrush" Color="#EFF4FE" />
        <SolidColorBrush x:Key="ButtonGhostHoverBrush" Color="#EEF1F5" />
        <SolidColorBrush x:Key="ButtonDestructiveBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="ButtonDestructiveHoverBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="ButtonRingBrush" Color="#802563EB" />
        <SolidColorBrush x:Key="ButtonDarkHoverBrush" Color="#2A3342" />

        <Style x:Key="ShadcnButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="11"
                                Padding="2">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000000" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonPrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ButtonRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShadcnSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadcnButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="11" Padding="2">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05" Color="#000000" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonSecondaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ButtonRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShadcnOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadcnButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="11" Padding="2">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05" Color="#000000" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonOutlineHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ButtonRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ButtonRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShadcnGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadcnButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="11" Padding="2">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonGhostHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ButtonRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShadcnDestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadcnButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ButtonDestructiveBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusRing" BorderBrush="Transparent" BorderThickness="2" CornerRadius="11" Padding="2">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000000" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ButtonDestructiveHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource ButtonRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShadcnLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadcnGhostButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style x:Key="ShadcnIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadcnSecondaryButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="ShadcnSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadcnButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ShadcnLargeButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadcnButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="32,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>


        <!--
            Seçili menü rengine bağlı buton stilleri.
            Button.Background aktif menünün ana renginden, Button.BorderBrush yumuşak border renginden,
            Button.Tag ise focus/pressed fosforlu ring renginden beslenir.
        -->
        <Style x:Key="ThemedPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadcnButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryForegroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="11"
                                Padding="2">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.09" Color="#000000" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ShadcnSecondaryButtonStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FocusRing"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="11"
                                Padding="2">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.05" Color="#000000" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
