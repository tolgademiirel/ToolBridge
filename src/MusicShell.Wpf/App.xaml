                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource PanelMutedBrush}" />
                                <Setter TargetName="SelectedGlyph" Property="Visibility" Value="Visible" />
                                <Setter TargetName="StatusDot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="StatusDot" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
